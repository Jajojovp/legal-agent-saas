# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
# Local development only. Production always verifies the database certificate.
# DB_SSL_REJECT_UNAUTHORIZED="false"
# For the explicit read-only RLS staging check only; never point these at production.
# STAGING_DATABASE_URL="postgresql://..."
# STAGING_DATABASE_HOST="your-staging-db-host"

# AI Provider  
GOOGLE_API_KEY=""
GOOGLE_AI_MODEL="gemini-1.5-flash"

# Distributed production rate limiting (Upstash Redis REST-compatible)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auth (NextAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 behind a trusted reverse proxy (e.g. production VPS with HTTPS).
AUTH_TRUST_HOST="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
